# Server Port Configuration
PORT=5000

# MongoDB Connection String (Replace with your local or Atlas URI)
MONGO_URI=mongodb://localhost:27017/smartstock_db_name

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Initial Seed Admin Credentials (used by scripts/seedAdmin.js)
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@smartstock.com
SEED_ADMIN_PASSWORD=admin123
