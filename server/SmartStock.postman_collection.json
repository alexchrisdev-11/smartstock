    {
      "name": "StockLogs",
      "description": "Inventory movement audit trails (stock in / stock out) and product quantity tracking.",
      "item": [
        {
          "name": "01. Create Stock In Log (+20)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product\": \"{{productId}}\",\n  \"type\": \"in\",\n  \"quantity\": 20,\n  \"note\": \"Initial supplier restock shipment PO-101\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/stocklogs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stocklogs"]
            },
            "description": "Records incoming stock adjustment and increments product quantity atomically."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Stock updated successfully\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.log.type).to.eql('in');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "02. Create Stock Out Log (-5)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staffToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product\": \"{{productId}}\",\n  \"type\": \"out\",\n  \"quantity\": 5,\n  \"note\": \"Customer fulfillment order #4492\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/stocklogs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stocklogs"]
            },
            "description": "Records outgoing stock deduction and decrements product quantity atomically."
